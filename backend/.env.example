APP_NAME=AnalystAI
APP_ENV=development
DEBUG=false
DEMO_MODE=true

# Application PostgreSQL database (Supabase PostgreSQL project)
# Format: postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_OR_DIRECT_HOST]:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Analytical / business dataset database URL
# Defaults to the 'analytics' schema in the same Supabase database.
ANALYTICS_DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# CORS Allowed Origins (comma-separated string or array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# Query execution guardrails
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=5

# AI Providers (mock, openai, anthropic, ollama)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_STORE_PROVIDER=mock
LOG_LEVEL=INFO

# Security & JWT
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440