APP_NAME=AnalystAI
APP_ENV=development
DEBUG=false
DEMO_MODE=true

# Application PostgreSQL database (e.g. Supabase or local PostgreSQL)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# In local development, falls back safely to sqlite:///./data/analystai.db if unset
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Analytical demo dataset (defaults to local SQLite warehouse)
ANALYTICS_DATABASE_URL=sqlite:///./data/analystai_analytics.db

# CORS Allowed Origins (comma-separated string or array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# Query execution guardrails
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=5

# AI Providers (mock, openai, anthropic, ollama)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_STORE_PROVIDER=mock
LOG_LEVEL=INFO

# Security & JWT
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440