# AnalystAI Root Environment Configuration
# Backend configuration
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/analystai.db
ANALYTICS_DATABASE_URL=sqlite:///./data/analystai_analytics.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=5

# AI / NLP Providers (Defaults to safe local deterministic mocks)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_STORE_PROVIDER=mock
LOG_LEVEL=INFO

# Frontend configuration
VITE_API_BASE_URL=/api/v1
